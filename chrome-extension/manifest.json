{
  "manifest_version": 3,
  "name": "VIGIL Trust Score",
  "version": "1.0.0",
  "description": "See the real trust score of any Polymarket trader. Calibration, live edge, on-chain verification — before you copy-trade.",
  "permissions": [],
  "host_permissions": [
    "https://polymarket.com/*",
    "https://vigil-trust-api.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*"],
      "js": ["content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/vigil-16.png",
    "48": "icons/vigil-48.png",
    "128": "icons/vigil-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/vigil-16.png",
      "48": "icons/vigil-48.png"
    }
  }
}
